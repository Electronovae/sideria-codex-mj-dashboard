+// ── Fusion : import incrémental (une session, quelques PNJ, etc.) ─
+// Contrairement à un import classique qui remplace tout l'univers, fusionnerUnivers()
+// prend un JSON partiel et upsert (ajoute ou met à jour par id) dans l'univers existant,
+// sans jamais rien supprimer. Le JSON partiel peut ne contenir que les clés qui t'intéressent
+// (ex: juste { "campagnes": [ { "id": "cmp_xxx", "sessions": [ {...} ] } ] }).
+const upsertParId = (listeExistante, listePartielle) => {
+  if (!Array.isArray(listePartielle)) return listeExistante
+  const copie = [...listeExistante]
+  listePartielle.forEach(item => {
+    if (!item || !item.id) return
+    const i = copie.findIndex(x => x.id === item.id)
+    if (i === -1) copie.push(item)
+    else copie[i] = { ...copie[i], ...item }
+  })
+  return copie
+}
+
+// Pour les sessions à l'intérieur d'une campagne : upsert par id, ou par code si l'id est absent
+// ou inconnu (pratique pour coller une session déjà codée DB00S04 sans connaître son id interne).
+const upsertSessions = (sessionsExistantes, sessionsPartielles) => {
+  if (!Array.isArray(sessionsPartielles)) return sessionsExistantes
+  const copie = [...sessionsExistantes]
+  sessionsPartielles.forEach(s => {
+    let i = -1
+    if (s.id) i = copie.findIndex(x => x.id === s.id)
+    if (i === -1 && s.code) i = copie.findIndex(x => x.code === s.code)
+    if (i === -1) copie.push({ ...nouvelleSession(), ...s })
+    else copie[i] = { ...copie[i], ...s, sections: s.sections ?? copie[i].sections, joueurIds: s.joueurIds ?? copie[i].joueurIds }
+  })
+  return copie
+}
+
+const upsertCampagnes = (campagnesExistantes, campagnesPartielles) => {
+  if (!Array.isArray(campagnesPartielles)) return campagnesExistantes
+  const copie = [...campagnesExistantes]
+  campagnesPartielles.forEach(c => {
+    let i = -1
+    if (c.id) i = copie.findIndex(x => x.id === c.id)
+    if (i === -1 && c.code) i = copie.findIndex(x => x.code === c.code)
+    if (i === -1) { copie.push(c); return }
+    const existante = copie[i]
+    copie[i] = { ...existante, ...c, sessions: upsertSessions(existante.sessions || [], c.sessions) }
+  })
+  return copie
+}
+
+export const fusionnerUnivers = (existant, partiel) => {
+  const u = structuredClone(existant)
+  if (partiel.meta) {
+    u.meta = { ...u.meta, ...partiel.meta }
+    if (Array.isArray(partiel.meta.saisons)) {
+      partiel.meta.saisons.forEach(s => {
+        const i = u.meta.saisons.findIndex(x => x.num === s.num)
+        if (i === -1) u.meta.saisons.push(s)
+        else u.meta.saisons[i] = { ...u.meta.saisons[i], ...s }
+      })
+    }
+  }
+  u.factions = upsertParId(u.factions, partiel.factions)
+  u.pnjs = upsertParId(u.pnjs, partiel.pnjs)
+  u.joueurs = upsertParId(u.joueurs, partiel.joueurs)
+  u.evenements = upsertParId(u.evenements, partiel.evenements)
+  u.lieux = upsertParId(u.lieux, partiel.lieux)
+  u.rapports = upsertParId(u.rapports, partiel.rapports)
+  u.arcs = upsertParId(u.arcs, partiel.arcs)
+  u.campagnes = upsertCampagnes(u.campagnes, partiel.campagnes)
+  return normaliser(u)
+}
