+// Import « fusion » : le fichier n'a pas besoin d'être un univers complet.
+// Il peut ne contenir que ce qu'on veut ajouter/mettre à jour (une session, un événement,
+// un PNJ...) ; tout le reste de l'univers courant est conservé tel quel.
+export function importerJsonFusion(fichier, universActuel) {
+  return new Promise((resoudre, rejeter) => {
+    const lecteur = new FileReader()
+    lecteur.onload = () => {
+      try {
+        const partiel = JSON.parse(lecteur.result)
+        resoudre(fusionnerUnivers(universActuel, partiel))
+      } catch (e) { rejeter(e) }
+    }
+    lecteur.onerror = rejeter
+    lecteur.readAsText(fichier)
+  })
+}
+
